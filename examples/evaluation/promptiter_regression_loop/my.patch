+		if emitted == nil {
+			emitted = evt
+		}
+	}
+	if emitted == nil {
+		t.Fatal("expected a state delta event to be emitted")
+	}
+	stored, ok := emitted.StateDelta["out"]
+	if !ok {
+		t.Fatalf("expected state delta for key 'out', got %v", emitted.StateDelta)
+	}
+	var parsed map[string]any
+	if err := json.Unmarshal(stored, &parsed); err != nil {
+		t.Fatalf("stored state must be parsable JSON, got error %v; stored: %s", err, stored)
+	}
+	if parsed["reason"] != "回复结构完整" {
+		t.Fatalf("unexpected repaired value: %v", parsed["reason"])
+	}
+}
