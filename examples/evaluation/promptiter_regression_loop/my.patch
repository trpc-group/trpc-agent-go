+// JSON that actually parsed - not the original invalid payload.
+func TestHandleOutputKey_StoresRepairedJSON(t *testing.T) {
+	ctx := context.Background()
+	schema := map[string]any{"type": "object"}
+	processor := NewOutputResponseProcessor("out", schema)
+	invocation := agent.NewInvocation()
+
+	// Invalid JSON: unquoted string value. Control-char repair alone cannot
+	// fix it; only the unquoted-string repair path makes it parsable.
+	invalid := "{\"reason\": 回复结构完整}"
+	response := &model.Response{
+		Done:    true,
+		Choices: []model.Choice{{Message: model.Message{Content: invalid}}},
+	}
+
+	eventCh := make(chan *event.Event, 1)
+	go func() {
+		processor.ProcessResponse(ctx, invocation, &model.Request{}, response, eventCh)
+		close(eventCh)
+	}()
