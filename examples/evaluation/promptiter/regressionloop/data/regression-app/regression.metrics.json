[
  {
    "metricName": "response_pattern",
    "evaluatorName": "final_response_avg_score",
    "threshold": 1,
    "criterion": {
      "finalResponse": {
        "text": {"matchStrategy": "regex"}
      }
    }
  },
  {
    "metricName": "json_format",
    "evaluatorName": "final_response_avg_score",
    "threshold": 1,
    "criterion": {
      "finalResponse": {
        "json": {"valid": true, "matchStrategy": "skip"}
      }
    }
  },
  {
    "metricName": "tool_trajectory",
    "evaluatorName": "tool_trajectory_avg_score",
    "threshold": 1,
    "criterion": {
      "toolTrajectory": {
        "orderSensitive": true,
        "defaultStrategy": {
          "name": {"matchStrategy": "exact"},
          "arguments": {"matchStrategy": "exact"},
          "result": {"matchStrategy": "skip"}
        }
      }
    }
  }
]
