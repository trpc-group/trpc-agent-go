--- /dev/null
+++ b/math.go
@@ -0,0 +1,23 @@
+package main
+
+func Add(a, b int) int {
+	return a + b
+}
+
+func Multiply(a, b int) int {
+	return a * b
+}
+
+func Divide(a, b int) int {
+	return a / b
+}
+
+func Subtract(a, b int) int {
+	return a - b
+}
+
+func Power(base, exp int) int {
+	result := 1
+	for i := 0; i < exp; i++ {
+		result *= base
+	}
+	return result
+}
