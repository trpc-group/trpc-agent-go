diff --git a/db.go b/db.go
--- a/db.go
+++ b/db.go
@@ -1,0 +1,10 @@
+package main
+func connect() (*sql.DB, error) {
+    db, err := sql.Open("sqlite3", "x.db")
+    if err != nil {
+        return nil, err
+    }
+    defer db.Close()
+    if err := db.Ping(); err != nil {
+        return nil, err
+    }
+    return db, nil
+}
