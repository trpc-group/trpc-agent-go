diff --git a/loop.go b/loop.go
--- a/loop.go
+++ b/loop.go
@@ -1,0 +1,9 @@
+package loop
+func consume(ctx context.Context, ch <-chan Message) {
+    for {
+        select {
+        case <-ctx.Done():
+            return
+        case msg := <-ch:
+            handle(ctx, msg)
+        }
+    }
+}
