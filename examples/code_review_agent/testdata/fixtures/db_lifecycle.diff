 package order
 
 import "database/sql"
 
 func Save(db *sql.DB, id string) error {
+	tx, err := db.Begin()
+	if err != nil {
+		return err
+	}
+	_, err = tx.Exec("insert into orders(id) values(?)", id)
+	return err
 }
