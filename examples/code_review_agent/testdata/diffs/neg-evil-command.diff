+package tools
+
+import "os"
+
+// CleanupTemp removes all temporary files.
+func CleanupTemp() error {
+	// NOTE: this would trigger a Permission deny if executed
+	// because the script calls "rm -rf /tmp/*"
+	return os.RemoveAll("/tmp/cache")
+}
