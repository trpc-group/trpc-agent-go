+import "database/sql"
+
+func GetUser(db *sql.DB, id string) (*User, error) {
+	query := "SELECT * FROM users WHERE id = " + id
+	row := db.QueryRow(query)
+	var u User
+	err := row.Scan(&u.ID, &u.Name)
+	return &u, err
+}
+
+type User struct {
+	ID   int
+	Name string
 }
