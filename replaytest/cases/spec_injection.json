{
  "name": "injection_comprehensive",
  "description": "Comprehensive injection test baseline Spec: covers all dimensions including events, state, tool calls, memory, summary, and tracks. Serves as the baseline for inconsistency injection detection. Test code constructs snapshots from this spec and manually injects inconsistencies to verify 100% detection rate.",
  "tags": ["integration", "injection"],
  "backends": {
    "session": ["inmemory", "sqlite"],
    "memory": ["inmemory", "sqlite"]
  },
  "setup": {
    "app_name": "test-app",
    "user_id": "user1",
    "session_id": "sess-injection-1",
    "init_state": {}
  },
  "operations": [
    { "op": "create_session", "backend": "session", "params": {} },
    { "op": "update_app_state", "backend": "session", "params": { "app:version": "1.0" } },
    { "op": "update_user_state", "backend": "session", "params": { "pref:theme": "dark" } },
    { "op": "append_user_event", "backend": "session", "params": { "author": "user1", "content": "Search for flights to Tokyo", "branch": "main" } },
    { "op": "append_tool_call_event", "backend": "session", "params": { "author": "assistant", "branch": "main", "tool_calls": [{ "id": "call_flight", "name": "search_flights", "arguments": "{\"destination\":\"Tokyo\"}" }] } },
    { "op": "append_tool_response_event", "backend": "session", "params": { "author": "tool", "content": "Found 3 flights to Tokyo", "branch": "main", "tool_id": "call_flight", "tool_name": "search_flights" } },
    { "op": "append_assistant_event", "backend": "session", "params": { "author": "assistant", "content": "I found 3 flights to Tokyo.", "branch": "main" } },
    { "op": "append_track_event", "backend": "session", "params": { "track": "search_timing", "payload": { "duration_ms": 245, "results": 3 } } },
    { "op": "create_summary", "backend": "session", "params": { "filterKey": "main", "force": true } },
    { "op": "add_memory", "backend": "memory", "params": { "memory": "User wants to fly to Tokyo", "topics": ["travel"] } },
    { "op": "add_memory_with_metadata", "backend": "memory", "params": { "memory": "User prefers window seats", "topics": ["preference"], "kind": "fact" } }
  ],
  "verifies": [
    { "what": "events", "params": {} },
    { "what": "state", "params": {} },
    { "what": "summary", "params": {} },
    { "what": "tracks", "params": {} },
    { "what": "memories", "params": {} },
    { "what": "session_full", "params": {} }
  ],
  "allowed_diffs": [
    { "path": "$.events[*].id", "kind": "auto_id", "strategy": "ignore" },
    { "path": "$.events[*].timestamp", "kind": "timestamp_drift", "strategy": "allow_drift", "max_drift": { "duration_ms": 5000 } },
    { "path": "$.summaries[*].updated_at", "kind": "timestamp_drift", "strategy": "allow_drift", "max_drift": { "duration_ms": 5000 } },
    { "path": "$.tracks[*].events[*].timestamp", "kind": "timestamp_drift", "strategy": "allow_drift", "max_drift": { "duration_ms": 5000 } },
    { "path": "$.memories[*].created_at", "kind": "timestamp_drift", "strategy": "allow_drift", "max_drift": { "duration_ms": 5000 } },
    { "path": "$.memories[*].updated_at", "kind": "timestamp_drift", "strategy": "allow_drift", "max_drift": { "duration_ms": 5000 } }
  ]
}
