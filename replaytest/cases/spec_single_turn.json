{
  "name": "single_turn",
  "description": "Single-turn conversation: user message and assistant text event only",
  "tags": ["lightweight", "event"],
  "backends": {
    "session": ["inmemory", "sqlite"],
    "memory": ["inmemory", "sqlite"]
  },
  "setup": {
    "app_name": "test-app",
    "user_id": "user1",
    "session_id": "sess-single-turn-1",
    "init_state": {}
  },
  "operations": [
    {
      "op": "create_session",
      "backend": "session",
      "params": {}
    },
    {
      "op": "append_user_event",
      "backend": "session",
      "params": {
        "author": "user1",
        "content": "Hello, what is the weather?",
        "branch": "main",
        "tag": "greeting"
      }
    },
    {
      "op": "append_assistant_event",
      "backend": "session",
      "params": {
        "author": "assistant",
        "content": "The weather is sunny with a high of 72F.",
        "branch": "main",
        "tag": "response",
        "state_delta": { "weather:last_asked": "2024-01-01T00:00:00Z" }
      }
    }
  ],
  "verifies": [
    { "what": "events", "params": {} },
    { "what": "state", "params": { "keys": ["weather:last_asked"] } }
  ],
  "allowed_diffs": [
    { "path": "$.events[*].id", "kind": "auto_id", "strategy": "ignore", "note": "Event IDs auto-generated" },
    { "path": "$.events[*].timestamp", "kind": "timestamp_drift", "strategy": "allow_drift", "max_drift": { "duration_ms": 5000 }, "note": "Timestamp drift allowed" }
  ]
}
