{
  "name": "multi_turn",
  "description": "Multi-turn conversation: sequentially append multiple user/assistant events and verify read order",
  "tags": ["lightweight", "event", "sequence"],
  "backends": {
    "session": ["inmemory", "sqlite"],
    "memory": ["inmemory", "sqlite"]
  },
  "setup": {
    "app_name": "test-app",
    "user_id": "user1",
    "session_id": "sess-multi-turn-1",
    "init_state": {}
  },
  "operations": [
    { "op": "create_session", "backend": "session", "params": {} },
    { "op": "append_user_event", "backend": "session", "params": { "author": "user1", "content": "Hi", "branch": "main" } },
    { "op": "append_assistant_event", "backend": "session", "params": { "author": "assistant", "content": "Hello! How can I help?", "branch": "main" } },
    { "op": "append_user_event", "backend": "session", "params": { "author": "user1", "content": "What is the capital of France?", "branch": "main" } },
    { "op": "append_assistant_event", "backend": "session", "params": { "author": "assistant", "content": "The capital of France is Paris.", "branch": "main" } },
    { "op": "append_user_event", "backend": "session", "params": { "author": "user1", "content": "Thanks!", "branch": "main" } },
    { "op": "append_assistant_event", "backend": "session", "params": { "author": "assistant", "content": "You're welcome!", "branch": "main" } }
  ],
  "verifies": [
    { "what": "events", "params": {} }
  ],
  "allowed_diffs": [
    { "path": "$.events[*].id", "kind": "auto_id", "strategy": "ignore" },
    { "path": "$.events[*].timestamp", "kind": "timestamp_drift", "strategy": "allow_drift", "max_drift": { "duration_ms": 5000 } }
  ]
}
