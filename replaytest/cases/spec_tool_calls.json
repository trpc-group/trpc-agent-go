{
  "name": "tool_calls",
  "description": "Tool call conversation: includes tool call, tool response, and tool call args extension",
  "tags": ["lightweight", "event", "tool"],
  "backends": {
    "session": ["inmemory", "sqlite"],
    "memory": ["inmemory", "sqlite"]
  },
  "setup": {
    "app_name": "test-app",
    "user_id": "user1",
    "session_id": "sess-tool-calls-1",
    "init_state": {}
  },
  "operations": [
    { "op": "create_session", "backend": "session", "params": {} },
    { "op": "append_user_event", "backend": "session", "params": { "author": "user1", "content": "Search for the weather in Beijing", "branch": "main" } },
    { "op": "append_tool_call_event", "backend": "session", "params": { "author": "assistant", "branch": "main", "tool_calls": [{ "id": "call_1", "name": "search", "arguments": "{\"query\":\"Beijing weather\"}" }] } },
    { "op": "append_tool_response_event", "backend": "session", "params": { "author": "tool", "content": "Temperature: 25C, Sunny", "branch": "main", "tool_id": "call_1", "tool_name": "search", "tool_call_id": "call_1" } },
    { "op": "append_assistant_event", "backend": "session", "params": { "author": "assistant", "content": "The weather in Beijing is 25C and sunny.", "branch": "main" } }
  ],
  "verifies": [
    { "what": "events", "params": {} },
    { "what": "state", "params": {} }
  ],
  "allowed_diffs": [
    { "path": "$.events[*].id", "kind": "auto_id", "strategy": "ignore" },
    { "path": "$.events[*].timestamp", "kind": "timestamp_drift", "strategy": "allow_drift", "max_drift": { "duration_ms": 5000 } }
  ]
}
