{
  "name": "full_cycle",
  "description": "Full lifecycle: complete integration test covering Session, Memory, Summary, and Track in a single end-to-end flow",
  "tags": ["integration", "full"],
  "backends": {
    "session": ["inmemory", "sqlite"],
    "memory": ["inmemory", "sqlite"]
  },
  "setup": {
    "app_name": "test-app",
    "user_id": "user1",
    "session_id": "sess-full-1",
    "init_state": {}
  },
  "operations": [
    { "op": "create_session", "backend": "session", "params": {} },
    { "op": "update_app_state", "backend": "session", "params": { "app:version": "1.0" } },
    { "op": "update_user_state", "backend": "session", "params": { "pref:theme": "dark" } },
    { "op": "append_user_event", "backend": "session", "params": { "author": "user1", "content": "I need to book a flight to Tokyo", "branch": "main" } },
    { "op": "append_assistant_event", "backend": "session", "params": { "author": "assistant", "content": "Let me search for flights to Tokyo for you.", "branch": "main" } },
    { "op": "append_tool_call_event", "backend": "session", "params": { "author": "assistant", "branch": "main", "tool_calls": [{ "id": "call_flight", "name": "search_flights", "arguments": "{\"destination\":\"Tokyo\"}" }] } },
    { "op": "append_tool_response_event", "backend": "session", "params": { "author": "tool", "content": "Found 3 flights: CA123 $500, MU456 $480, NH789 $550", "branch": "main", "tool_id": "call_flight", "tool_name": "search_flights", "tool_call_id": "call_flight" } },
    { "op": "append_assistant_event", "backend": "session", "params": { "author": "assistant", "content": "I found 3 flights to Tokyo. The cheapest is MU456 at $480.", "branch": "main", "state_delta": { "booking:status": "searching" } } },
    { "op": "append_track_event", "backend": "session", "params": { "track": "flight_search", "payload": { "duration_ms": 245, "results": 3, "provider": "sky_scanner" } } },
    { "op": "add_memory", "backend": "memory", "params": { "memory": "User wants to fly to Tokyo", "topics": ["travel", "current_task"] } },
    { "op": "add_memory_with_metadata", "backend": "memory", "params": { "memory": "User searched flights with sky_scanner on 2024-06-15", "topics": ["travel", "activity"], "kind": "episode", "event_time": "2024-06-15T10:30:00Z" } },
    { "op": "append_user_event", "backend": "session", "params": { "author": "user1", "content": "Book the cheapest one", "branch": "main" } },
    { "op": "append_tool_call_event", "backend": "session", "params": { "author": "assistant", "branch": "main", "tool_calls": [{ "id": "call_book", "name": "book_flight", "arguments": "{\"flight\":\"MU456\"}" }] } },
    { "op": "append_tool_response_event", "backend": "session", "params": { "author": "tool", "content": "Booked: MU456, $480, June 20 2024", "branch": "main", "tool_id": "call_book", "tool_name": "book_flight" } },
    { "op": "append_assistant_event", "backend": "session", "params": { "author": "assistant", "content": "Flight MU456 booked successfully! You'll fly on June 20.", "branch": "main", "state_delta": { "booking:status": "confirmed" } } },
    { "op": "append_track_event", "backend": "session", "params": { "track": "booking", "payload": { "flight": "MU456", "price": 480, "status": "confirmed", "duration_ms": 510 } } },
    { "op": "search_memories", "backend": "memory", "params": { "query": "Tokyo flight" } },
    { "op": "update_session_state", "backend": "session", "params": { "temp:sidebar": "collapsed" } }
  ],
  "verifies": [
    { "what": "events", "params": {} },
    { "what": "state", "params": {} },
    { "what": "tracks", "params": {} },
    { "what": "memories", "params": {} },
    { "what": "session_full", "params": {} }
  ],
  "allowed_diffs": [
    { "path": "$.events[*].id", "kind": "auto_id", "strategy": "ignore" },
    { "path": "$.events[*].timestamp", "kind": "timestamp_drift", "strategy": "allow_drift", "max_drift": { "duration_ms": 5000 } },
    { "path": "$.tracks[*].events[*].timestamp", "kind": "timestamp_drift", "strategy": "allow_drift", "max_drift": { "duration_ms": 5000 } },
    { "path": "$.memories[*].created_at", "kind": "timestamp_drift", "strategy": "allow_drift", "max_drift": { "duration_ms": 5000 } },
    { "path": "$.memories[*].updated_at", "kind": "timestamp_drift", "strategy": "allow_drift", "max_drift": { "duration_ms": 5000 } }
  ]
}
