{
  "name": "summary_generation",
  "description": "Summary generation and update: verify summary content, filter-key, version, and session ownership across branches",
  "tags": ["lightweight", "summary"],
  "backends": {
    "session": ["inmemory", "sqlite"],
    "memory": ["inmemory", "sqlite"]
  },
  "setup": {
    "app_name": "test-app",
    "user_id": "user1",
    "session_id": "sess-summary-1",
    "init_state": {}
  },
  "operations": [
    { "op": "create_session", "backend": "session", "params": {} },
    { "op": "append_user_event", "backend": "session", "params": { "author": "user1", "content": "Tell me about machine learning", "branch": "main" } },
    { "op": "append_assistant_event", "backend": "session", "params": { "author": "assistant", "content": "Machine learning is a field of AI focused on learning from data.", "branch": "main" } },
    { "op": "append_user_event", "backend": "session", "params": { "author": "user1", "content": "What about deep learning?", "branch": "main" } },
    { "op": "append_assistant_event", "backend": "session", "params": { "author": "assistant", "content": "Deep learning uses neural networks with many layers.", "branch": "main" } },
    { "op": "create_summary", "backend": "session", "params": { "filterKey": "main", "force": true } },
    { "op": "append_user_event", "backend": "session", "params": { "author": "user1", "content": "Also tell me about RL", "branch": "dev" } },
    { "op": "append_assistant_event", "backend": "session", "params": { "author": "assistant", "content": "Reinforcement learning is learning through trial and error.", "branch": "dev" } },
    { "op": "create_summary", "backend": "session", "params": { "filterKey": "dev", "force": true } },
    { "op": "enqueue_summary", "backend": "session", "params": { "filterKey": "main", "force": true } }
  ],
  "verifies": [
    { "what": "summary", "expect": {"filter_keys": ["main", "dev"]} },
    { "what": "events", "params": {} }
  ],
  "allowed_diffs": [
    { "path": "$.events[*].id", "kind": "auto_id", "strategy": "ignore" },
    { "path": "$.events[*].timestamp", "kind": "timestamp_drift", "strategy": "allow_drift", "max_drift": { "duration_ms": 5000 } },
    { "path": "$.summaries[*].updated_at", "kind": "timestamp_drift", "strategy": "allow_drift", "max_drift": { "duration_ms": 5000 } },
    { "path": "$.summaries.", "kind": "backend_metadata", "strategy": "ignore", "note": "Some backends auto-populate a default (empty filter-key) summary when any summary is created; others do not." }
  ]
}
