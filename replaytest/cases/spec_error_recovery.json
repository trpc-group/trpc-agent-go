{
  "name": "error_recovery",
  "description": "Error recovery: simulate duplicate writes, overwrite updates, delete-then-rewrite, and idempotency verification. Tests abnormal paths including state overwrite chains, memory delete-then-re-add, and repeated updates to the same key, ensuring consistent final state with no dirty data.",
  "tags": ["lightweight", "error", "idempotency"],
  "backends": {
    "session": ["inmemory", "sqlite"],
    "memory": ["inmemory", "sqlite"]
  },
  "setup": {
    "app_name": "test-app",
    "user_id": "user1",
    "session_id": "sess-error-1",
    "init_state": {}
  },
  "operations": [
    { "op": "create_session", "backend": "session", "params": {} },
    { "op": "append_user_event", "backend": "session", "params": { "author": "user1", "content": "Original message", "branch": "main" } },
    { "op": "append_assistant_event", "backend": "session", "params": { "author": "assistant", "content": "Response 1", "branch": "main", "tag": "retry" } },
    { "op": "update_session_state", "backend": "session", "params": { "temp:step": "first_write" } },
    { "op": "update_session_state", "backend": "session", "params": { "temp:step": "overwritten" } },
    { "op": "update_session_state", "backend": "session", "params": { "temp:step": "" } },
    { "op": "update_session_state", "backend": "session", "params": { "temp:step": "rewritten_after_delete" } },
    { "op": "update_session_state", "backend": "session", "params": { "temp:retry_count": "1" } },
    { "op": "update_session_state", "backend": "session", "params": { "temp:retry_count": "2" } },
    { "op": "update_session_state", "backend": "session", "params": { "temp:retry_count": "3" } },
    { "op": "add_memory", "backend": "memory", "params": { "memory": "Recovery test memory item", "topics": ["test", "recovery"] } },
    { "op": "add_memory", "backend": "memory", "params": { "memory": "Recovery test memory item - rewritten", "topics": ["test", "recovery"] } },
    { "op": "add_memory_with_metadata", "backend": "memory", "params": { "memory": "Idempotent memory entry", "topics": ["idempotent"], "kind": "fact", "event_time": "2025-01-15T12:00:00Z" } },
    { "op": "add_memory", "backend": "memory", "params": { "memory": "Extra memory that will be cleared", "topics": ["temp"] } },
    { "op": "clear_memories", "backend": "memory", "params": {} },
    { "op": "add_memory", "backend": "memory", "params": { "memory": "Final surviving memory after clear", "topics": ["final"] } },
    { "op": "update_app_state", "backend": "session", "params": { "app:version": "1.0" } },
    { "op": "update_app_state", "backend": "session", "params": { "app:version": "1.1" } },
    { "op": "delete_app_state_key", "backend": "session", "params": { "key": "app:version" } },
    { "op": "update_app_state", "backend": "session", "params": { "app:version": "2.0" } },
    { "op": "append_user_event", "backend": "session", "params": { "author": "user1", "content": "Follow-up after state overwrites and recovery operations", "branch": "main", "tag": "followup" } },
    { "op": "append_assistant_event", "backend": "session", "params": { "author": "assistant", "content": "Acknowledged - all recovery steps complete", "branch": "main" } }
  ],
  "verifies": [
    { "what": "events", "params": {} },
    { "what": "memories", "params": {} },
    { "what": "state", "params": {} }
  ],
  "allowed_diffs": [
    { "path": "$.events[*].id", "kind": "auto_id", "strategy": "ignore" },
    { "path": "$.events[*].timestamp", "kind": "timestamp_drift", "strategy": "allow_drift", "max_drift": { "duration_ms": 5000 } },
    { "path": "$.memories[*].created_at", "kind": "timestamp_drift", "strategy": "allow_drift", "max_drift": { "duration_ms": 5000 } },
    { "path": "$.memories[*].updated_at", "kind": "timestamp_drift", "strategy": "allow_drift", "max_drift": { "duration_ms": 5000 } }
  ]
}
