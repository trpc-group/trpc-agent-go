{
  "name": "out_of_order",
  "description": "Out-of-order writes: verify final replay order and normalized results across backends",
  "tags": ["lightweight", "concurrent", "ordering"],
  "backends": {
    "session": ["inmemory", "sqlite"],
    "memory": ["inmemory", "sqlite"]
  },
  "setup": {
    "app_name": "test-app",
    "user_id": "user1",
    "session_id": "sess-order-1",
    "init_state": {}
  },
  "operations": [
    { "op": "create_session", "backend": "session", "params": {} },
    { "op": "append_user_event", "backend": "session", "params": { "author": "user1", "content": "Trigger concurrent operations", "branch": "main", "tag": "trigger" } },
    { "op": "append_concurrent_events", "backend": "session", "params": {
      "events": [
        { "author": "user1", "content": "Message C - concurrent", "branch": "main", "tag": "c" },
        { "author": "user1", "content": "Message A - concurrent", "branch": "main", "tag": "a" },
        { "author": "user1", "content": "Message B - concurrent", "branch": "main", "tag": "b" }
      ]
    }},
    { "op": "append_assistant_event", "backend": "session", "params": { "author": "assistant", "content": "Response after concurrent group", "branch": "main", "tag": "response" } },
    { "op": "add_memory", "backend": "memory", "params": { "memory": "First memory - ordering test", "topics": ["order"] } },
    { "op": "add_memory", "backend": "memory", "params": { "memory": "Second memory - ordering test", "topics": ["order"] } },
    { "op": "add_memory", "backend": "memory", "params": { "memory": "Third memory - ordering test", "topics": ["order"] } }
  ],
  "verifies": [
    { "what": "events", "params": {} },
    { "what": "memories", "params": {} }
  ],
  "allowed_diffs": [
    { "path": "$.events[*].id", "kind": "auto_id", "strategy": "ignore" },
    { "path": "$.events[*].timestamp", "kind": "timestamp_drift", "strategy": "allow_drift", "max_drift": { "duration_ms": 5000 } },
    { "path": "$.memories[*].created_at", "kind": "timestamp_drift", "strategy": "allow_drift", "max_drift": { "duration_ms": 5000 } }
  ]
}
