{
  "name": "concurrent_writes",
  "description": "Concurrent writes: use append_concurrent_events to concurrently append multiple tool call and sub-agent events via goroutines, then verify that final replay order is consistent after concurrent-event sorting normalization. Each round applies the same race conditions across all backends.",
  "tags": ["lightweight", "concurrent"],
  "backends": {
    "session": ["inmemory", "sqlite"],
    "memory": ["inmemory", "sqlite"]
  },
  "setup": {
    "app_name": "test-app",
    "user_id": "user1",
    "session_id": "sess-concurrent-1",
    "init_state": {}
  },
  "operations": [
    { "op": "create_session", "backend": "session", "params": {} },
    { "op": "append_user_event", "backend": "session", "params": { "author": "user1", "content": "Run parallel tasks to search and fetch", "branch": "main" } },
    { "op": "append_tool_call_event", "backend": "session", "params": { "author": "assistant", "branch": "main", "tool_calls": [{ "id": "call_a", "name": "task_a" }, { "id": "call_b", "name": "task_b" }] } },
    { "op": "append_concurrent_events", "backend": "session", "params": {
      "events": [
        { "author": "tool", "content": "Result A - task completed", "branch": "main", "tag": "task_a", "tool_id": "call_a", "tool_name": "task_a" },
        { "author": "tool", "content": "Result B - task completed", "branch": "main", "tag": "task_b", "tool_id": "call_b", "tool_name": "task_b" }
      ]
    }},
    { "op": "append_assistant_event", "backend": "session", "params": { "author": "assistant", "content": "Both parallel tasks completed successfully.", "branch": "main" } },
    { "op": "append_user_event", "backend": "session", "params": { "author": "user1", "content": "Now run three more parallel lookups", "branch": "main" } },
    { "op": "append_concurrent_events", "backend": "session", "params": {
      "events": [
        { "author": "tool", "content": "Lookup X: value=42", "branch": "main", "tag": "lookup_x", "tool_id": "lx", "tool_name": "lookup" },
        { "author": "tool", "content": "Lookup Y: value=99", "branch": "main", "tag": "lookup_y", "tool_id": "ly", "tool_name": "lookup" },
        { "author": "tool", "content": "Lookup Z: value=17", "branch": "main", "tag": "lookup_z", "tool_id": "lz", "tool_name": "lookup" }
      ]
    }},
    { "op": "append_assistant_event", "backend": "session", "params": { "author": "assistant", "content": "All lookups returned: X=42, Y=99, Z=17", "branch": "main" } }
  ],
  "verifies": [
    { "what": "events", "params": {} },
    { "what": "session_full", "params": {} }
  ],
  "allowed_diffs": [
    { "path": "$.events[*].id", "kind": "auto_id", "strategy": "ignore" },
    { "path": "$.events[*].timestamp", "kind": "timestamp_drift", "strategy": "allow_drift", "max_drift": { "duration_ms": 5000 } }
  ]
}
